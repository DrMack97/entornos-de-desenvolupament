graph LR
    %% Definición de Actores
    Tutor((Tutor / Padre))
    Cuidador((Cuidador))
    Medico((Servicio Médico))
    Admin((Administrador))

    subgraph TapatApp [Sistema de Gestión TapatApp]
        %% RF1 y RF2: Acceso
        UC_REG(RF1: Registrarse)
        UC_LOG(RF2: Iniciar Sesión)

        %% Gestión de Perfiles
        UC_ALTA_N(RF3: Alta de Niño)
        UC_ALTA_C(RF6: Alta de Cuidadores)

        %% Control del Tratamiento (Core del Negocio)
        UC_CTRL_P(RF4/RF7: Control de Parche)
        UC_CONF_T(RF5: Configurar Tratamiento)
        
        %% Objetivos Adicionales
        UC_SHARE(Compartir Info con Médico)
        UC_REP(Ver Reportes de Evolución)
        UC_G_SIS(Gestionar Usuarios y Sistema)
    end

    %% Relaciones del Tutor (Actor Principal)
    Tutor --> UC_REG
    Tutor --> UC_LOG
    Tutor --> UC_ALTA_N
    Tutor --> UC_ALTA_C
    Tutor --> UC_CTRL_P
    Tutor --> UC_CONF_T
    Tutor --> UC_SHARE

    %% Relaciones del Cuidador
    Cuidador --> UC_LOG
    Cuidador --> UC_CTRL_P

    %% Relaciones del Servicio Médico
    Medico --> UC_LOG
    Medico --> UC_SHARE
    Medico --> UC_REP

    %% Relaciones del Administrador
    Admin --> UC_LOG
    Admin --> UC_G_SIS

    %% Relaciones de Inclusión (Lógica de Negocio)
    UC_CTRL_P -. "«include»" .-> UC_LOG
    UC_CONF_T -. "«include»" .-> UC_LOG
    
    %% Relación de Especialización de Tratamiento
    UC_CONF_T <|-- UC_T_FIJO(Tiempo Fijo Diario)
    UC_CONF_T <|-- UC_T_MITAD(1/2 del Tiempo Despierto)

    %% Actores Secundarios (Sistemas)
    Servidor[Servidor API]
    BBDD[(Base de Datos)]

    UC_LOG --- Servidor
    UC_CTRL_P --- BBDD
    UC_SHARE --- Medico