graph LR
    %% Actores Principales (Izquierda)
    Tutor((Tutor / Padre))
    Cuidador((Cuidador))
    Medico((Servicio Médico))

    subgraph Sistema_TapatApp [Sistema de Gestión TapatApp]
        direction TB
        
        subgraph Acceso [Gestión de Acceso]
            UC_REG("RF1: Registrarse")
            UC_LOG("RF2: Iniciar Sesión")
        end

        subgraph Gestion_Pacientes [Gestión de Niños y Cuidadores]
            UC_ALTA_N("RF3: Alta de Niño")
            UC_ALTA_C("RF6: Alta de Cuidadores")
        end

        subgraph Tratamiento [Control de Rehabilitación]
            UC_CONF_T("RF5: Configurar Tratamiento")
            UC_T_FIJO("Tratamiento Tiempo Fijo")
            UC_T_MITAD("Tratamiento 1/2 Tiempo")
            UC_CTRL_P("RF4/RF7: Control de Parche")
        end

        subgraph Seguimiento [Médico y Reportes]
            UC_SHARE("Compartir Info con Médico")
            UC_REP("Ver Reportes de Evolución")
            UC_G_SIS("Gestionar Usuarios y Sistema")
        end
    end

    %% Actores de Gestión y Soporte (Derecha)
    Admin((Administrador))
    Servidor[Servidor API]
    BBDD[(Base de Datos)]

    %% Relaciones Lógicas: Tutor
    Tutor --> UC_REG
    Tutor --> UC_LOG
    Tutor --> UC_ALTA_N
    Tutor --> UC_ALTA_C
    Tutor --> UC_CTRL_P
    Tutor --> UC_CONF_T
    Tutor --> UC_SHARE

    %% Relaciones Lógicas: Cuidador
    Cuidador --> UC_LOG
    Cuidador --> UC_CTRL_P

    %% Relaciones Lógicas: Medico
    Medico --> UC_LOG
    Medico --> UC_SHARE
    Medico --> UC_REP

    %% Relaciones Lógicas: Admin
    Admin --> UC_LOG
    Admin --> UC_G_SIS

    %% Dependencias Técnicas (Includes y Flujos)
    UC_CTRL_P -. "«include»" .-> UC_LOG
    UC_CONF_T -. "«include»" .-> UC_LOG
    UC_T_FIJO -- "tipo" --> UC_CONF_T
    UC_T_MITAD -- "tipo" --> UC_CONF_T

    %% Interacción con Sistemas
    UC_LOG --- Servidor
    UC_CTRL_P --- BBDD